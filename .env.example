# =====================================================================
# Sistema Inteligente FUNPES — variáveis de ambiente
# Copie para .env.local (desenvolvimento). NUNCA versione valores reais.
# Na Vercel, cadastre-as em Project Settings → Environment Variables,
# separando Preview e Production.
# =====================================================================

# --- Persistência --------------------------------------------------------
# demo     = dados FICTÍCIOS em memória (sem banco). Útil para avaliação local.
# supabase = PostgreSQL + Auth + Storage do Supabase (obrigatório em produção).
DATA_BACKEND=demo

# Em NODE_ENV=production o modo demo é bloqueado, salvo autorização explícita
# (ex.: deploy de prévia para demonstração). Nunca use "true" em produção real.
ALLOW_DEMO_IN_PRODUCTION=false

# Segredo para assinar a sessão do modo demo (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Arquivo de persistência local do modo demo (somente desenvolvimento).
# DEMO_PERSIST_FILE=.data/demo-db.json

# --- Supabase (DATA_BACKEND=supabase) -----------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: IGNORA RLS. Opcional; somente no servidor. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=project-documents

# --- Inteligência artificial --------------------------------------------
# local  = assistente determinístico, sem envio de dados para fora (padrão).
# gemini | openai = provedores externos (exigem AI_EXTERNAL_ALLOWED=true).
AI_PROVIDER=local
# Modelo do provedor externo (ex.: gemini-2.5-flash, gpt-4o-mini). Confirme o nome vigente na documentação do provedor.
AI_MODEL=
# Autorização institucional para envio de dados (minimizados e anonimizados) a provedores externos.
AI_EXTERNAL_ALLOWED=false
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_REQUESTS_PER_HOUR=60

# --- Uploads ------------------------------------------------------------
UPLOAD_MAX_MB=10
